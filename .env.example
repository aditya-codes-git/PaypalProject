# Copy the variables you need into the root .env file.
# .env is private and ignored by Git. Never use VITE_ for secrets.

# AI — backend only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase — sign-in and saved operations (both values are required)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Not required; financial writes use a scoped Edge Function gateway
SUPABASE_SECRET_KEY=
DATABASE_URL=
RELIEFOPS_SERVER_KEY=
APP_ORIGIN=http://127.0.0.1:5173

# PayPal — sandbox only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Optional default recipient; when empty, checkout uses the app's sandbox merchant.
PAYPAL_MERCHANT_ID=
# Optional JSON object mapping exact supplier names to sandbox merchant IDs.
PAYPAL_SUPPLIER_MERCHANTS={}


# Recovery runs once per minute while the service is awake.
RECOVERY_WORKER=true
